#!/bin/sh
# Inspect entire changed files as stored in the index.
paths=$(mktemp) || exit 1
trap 'rm -f -- "$paths"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z -- > "$paths" || exit 1

xargs -0 sh -c '
    for path do
        git grep --cached -q -E "TODO|FIXME" -- ":(literal)$path"
        result=$?
        case "$result" in
            0) printf "Commit rejected: staged file %s contains TODO or FIXME.\n" "$path" >&2
               exit 1 ;;
            1) ;;
            *) exit "$result" ;;
        esac
    done
' sh < "$paths"
